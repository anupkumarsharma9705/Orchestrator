<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Suppress false positives for generated code -->
    <Match>
        <Class name="~.*\.Generated"/>
    </Match>

    <!-- Suppress Lombok-generated code issues -->
    <Match>
        <Class name="~.*\$Builder"/>
    </Match>
    <Match>
        <Class name="~.*\$Value"/>
    </Match>

    <!-- Suppress DTO/Record serialization issues -->
    <Match>
        <Bug pattern="SE_BAD_FIELD"/>
        <Class name="~.*\.dto\..*"/>
    </Match>
    <Match>
        <Bug pattern="SE_NO_SERIALVERSIONID"/>
        <Class name="~.*\.dto\..*"/>
    </Match>

    <!-- Suppress JPA entity issues -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Class name="~.*\.domain\..*"/>
    </Match>
    <Match>
        <Bug pattern="SE_NO_SERIALVERSIONID"/>
        <Class name="~.*\.domain\..*"/>
    </Match>

    <!-- Suppress MapStruct mapper issues -->
    <Match>
        <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/>
        <Class name="~.*\.mapper\..*"/>
    </Match>

    <!-- Suppress test code issues -->
    <Match>
        <Class name="~.*Test"/>
        <Bug pattern="DMI_.*"/>
    </Match>
    <Match>
        <Class name="~.*Test"/>
        <Bug pattern="RV_.*"/>
    </Match>

    <!-- Allow secure random in tests -->
    <Match>
        <Class name="~.*Test"/>
        <Bug pattern="DMI_RANDOM_USED_ONLY_ONCE"/>
    </Match>

    <!-- Suppress serialization in configuration classes -->
    <Match>
        <Bug pattern="SE_NO_SERIALVERSIONID"/>
        <Class name="~.*\.config\..*"/>
    </Match>

    <!-- Spring beans intentionally hold injected collaborators. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Class name="~.*\.(config|security)\..*"/>
    </Match>

    <!-- This API is stateless and authenticates with the Authorization header,
         not cookies, so CSRF protection does not apply. Re-enable this check
         if cookie-based sessions are added. -->
    <Match>
        <Bug pattern="SPRING_CSRF_PROTECTION_DISABLED"/>
        <Class name="~.*\.config\.SecurityConfig"/>
    </Match>

    <!-- Request values and exception text are sanitized by sanitize() before
         logging (CR and LF are replaced), which this detector cannot see. -->
    <Match>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
        <Class name="~.*\.exception\.GlobalExceptionHandler"/>
    </Match>

    <!-- Reading the Authorization header is the purpose of the JWT filter. -->
    <Match>
        <Bug pattern="SERVLET_HEADER"/>
        <Class name="~.*\.security\.JwtAuthenticationFilter"/>
    </Match>

    <!-- Suppress security manager issues in Spring Boot -->
    <Match>
        <Bug pattern="DM_DEFAULT_ENCODING"/>
    </Match>
</FindBugsFilter>