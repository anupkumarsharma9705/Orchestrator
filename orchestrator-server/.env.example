# Example environment variables for running the server directly (without Docker).
# Copy to .env and fill in real values, or run scripts/dev-up from the repository
# root for a fully configured local stack. Never commit .env.

# Required: shared secret for the REST API (at least 32 characters).
# Generate with: openssl rand -hex 32
ORCHESTRATOR_API_KEY=

# Required when the default PostgreSQL profile is active.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/orchestrator
SPRING_DATASOURCE_USERNAME=companion
SPRING_DATASOURCE_PASSWORD=

# Required for the default TLS/mTLS listener. Point these at the files produced
# by scripts/generate-dev-certs.sh (or your own PKI).
SSL_KEY_STORE=classpath:certs/keystore.p12
SSL_TRUST_STORE=classpath:certs/truststore.p12
SSL_KEY_STORE_PASSWORD=
SSL_TRUST_STORE_PASSWORD=

# Optional model provider keys. At least one provider must be configured for
# real generation.
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
KAGGLE_API_KEY=
GITHUB_TOKEN=
