# Java Companion Orchestrator - Environment Configuration Example
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# =============================================================================
# REQUIRED: API Keys for LLM Providers
# =============================================================================
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Get from: https://console.nvidia.com/
NVIDIA_API_KEY=nvapi-...

# =============================================================================
# REQUIRED: Orchestrator Server Configuration
# =============================================================================
# Server API key (shared secret between CLI and Server)
ORCHESTRATOR_API_KEY=your-secure-api-key-here-min-32-chars

# Server URL (HTTPS in production)
ORCHESTRATOR_SERVER_URL=https://localhost:8443

# =============================================================================
# OPTIONAL: SSL/TLS Configuration (for production)
# =============================================================================
# Path to PKCS12 keystore (classpath: or file:)
SSL_KEY_STORE=classpath:certs/keystore.p12
SSL_KEY_STORE_PASSWORD=changeit
SSL_KEY_STORE_TYPE=PKCS12
SSL_KEY_ALIAS=orchestrator

# Path to PKCS12 truststore
SSL_TRUST_STORE=classpath:certs/truststore.p12
SSL_TRUST_STORE_PASSWORD=changeit
SSL_TRUST_STORE_TYPE=PKCS12

# Disable hostname verification for self-signed dev certs (NOT for production!)
SSL_VERIFY_HOSTNAME=false

# =============================================================================
# OPTIONAL: Database (for persistent CostTracker and ApprovalService)
# =============================================================================
# DATABASE_URL=jdbc:postgresql://localhost:5432/orchestrator
# DATABASE_USER=orchestrator
# DATABASE_PASSWORD=secure-password

# =============================================================================
# OPTIONAL: Model Router Configuration
# =============================================================================
# Default LLM provider: openai, nvidia
MODEL_ROUTER_DEFAULT_PROVIDER=nvidia

# Daily budget in USD
MODEL_ROUTER_DAILY_BUDGET_USD=10.0

# Budget per task in USD
MODEL_ROUTER_BUDGET_PER_TASK_USD=0.50

# =============================================================================
# OPTIONAL: Sandbox Configuration
# =============================================================================
# Docker image for sandbox containers
SANDBOX_DOCKER_IMAGE=eclipse-temurin:21-jdk

# Maven cache volume name
SANDBOX_MAVEN_CACHE_VOLUME=orchestrator-maven-cache

# Enable network in sandbox (security risk if true)
SANDBOX_ENABLE_NETWORK=false

# Allowed capabilities (empty = drop all)
# SANDBOX_ALLOWED_CAPABILITIES=CAP_DAC_OVERRIDE,CAP_FOWNER

# =============================================================================
# OPTIONAL: CLI Configuration
# =============================================================================
# Default project name
CLI_DEFAULT_PROJECT=my-project

# Default output format: table, json, markdown
CLI_OUTPUT_FORMAT=table

# Request timeout in seconds
CLI_TIMEOUT_SECONDS=600

# Log level: DEBUG, INFO, WARN, ERROR
CLI_LOG_LEVEL=INFO

# Disable colored output
CLI_NO_COLOR=false