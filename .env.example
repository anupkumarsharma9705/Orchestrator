# Copy this file to .env and fill in real values, or run scripts/dev-up
# (recommended) which generates all of the secrets for you.
#
# Never commit .env.

# Shared secret for the REST API. At least 32 characters.
# Generate with: openssl rand -hex 32
ORCHESTRATOR_API_KEY=

# Password for the bundled PostgreSQL container.
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Password for the development server/client keystores.
# Generate with: openssl rand -hex 24
CERT_PASSWORD=

# Optional model provider keys. At least one provider must be configured for
# real generation; the server itself starts without them.
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
# OpenRouter is disabled by default; enable it after setting the key:
# ORCHESTRATOR_MODEL_ROUTER_PROVIDERS_OPENROUTER_ENABLED=true
GITHUB_TOKEN=

# Optional: change the host port exposed by the compose stack.
# ORCHESTRATOR_PORT=8443
