# Copy this file to .env and fill in real values, or run scripts/dev-up
# (recommended) which generates all of the secrets for you.
#
# Never commit .env.

# Shared secret for the REST API. At least 32 characters.
# Generate with: openssl rand -hex 32
ORCHESTRATOR_API_KEY=

# Password for the bundled PostgreSQL container.
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Password for the development server/client keystores.
# Generate with: openssl rand -hex 24
CERT_PASSWORD=

# Model provider keys. At least one provider must be configured for real
# server-backed generation; the server itself starts without them.
#
# OpenRouter is enabled by default; set the key to activate it.
OPENROUTER_API_KEY=
# To disable OpenRouter explicitly:
# ORCHESTRATOR_MODEL_ROUTER_PROVIDERS_OPENROUTER_ENABLED=false
# Optional NVIDIA provider (the profile definitions use NVIDIA model names).
NVIDIA_API_KEY=
GITHUB_TOKEN=

# Optional: change the host port exposed by the compose stack.
# ORCHESTRATOR_PORT=8443

# Optional: name of the shared workspace volume used by the server and
# sandbox containers. The same value must be used by every service.
# ORCHESTRATOR_WORKSPACE_VOLUME=orchestrator-workspace

# Linux only: group id of /var/run/docker.sock when it is not root.
# Get it with: stat -c '%g' /var/run/docker.sock
# DOCKER_GID=0
